{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ollama (generative)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "generative",
        "--backend", "ollama",
        "--model-name", "hf.co/unsloth/Qwen3.6-27B-MTP-GGUF:UD-Q3_K_XL"
      ]
    },
    {
      "name": "Hugging Face (generative)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "generative",
        "--backend", "huggingface",
        "--model-name", "HuggingFaceTB/SmolLM2-1.7B",
        "--hf-device", "cuda:0"
      ]
    },
    {
      "name": "Hugging Face (CPU)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "generative",
        "--backend", "huggingface",
        "--model-name", "microsoft/Phi-3-mini-4k-instruct",
        "--hf-device", "cpu"
      ]
    },
    {
      "name": "Ollama (thinking)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "generative",
        "--backend", "ollama",
        "--model-name", "qwen3.6:latest"
      ],
      "env": { "THINKING": "true" }
    },
    {
      "name": "Embedding (Ollama fallback)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "embedding",
        "--backend", "ollama",
        "--model-name", "qwen3.6:latest",
        "--ollama-host", "localhost",
        "--ollama-port", "11434",
        "--embedding-model-name", "sentence-transformers/all-MiniLM-L6-v2",
        "--embedding-db", "./embeddings/log_embeddings.db",
        "--embedding-threshold", "0.8",
        "--hf-device", "cuda:0",
        "--log-dir", "./logs",
        "--output-dir", "./analysis",
        "--batch-size", "10"
      ]
    },
    {
      "name": "Embedding (Hugging Face fallback)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "embedding",
        "--backend", "huggingface",
        "--model-name", "HuggingFaceTB/SmolLM2-1.7B",
        "--hf-device", "cuda:0",
        "--embedding-model-name", "sentence-transformers/all-MiniLM-L6-v2",
        "--embedding-db", "./embeddings/log_embeddings.db",
        "--embedding-threshold", "0.8",
        "--log-dir", "./logs",
        "--output-dir", "./analysis",
        "--batch-size", "10"
      ]
    },
    {
      "name": "Custom args",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/scripts",
      "python": "${workspaceFolder}/scripts/.venv/bin/python",
      "module": "main",
      "args": [
        "--mode", "generative",
        "--backend", "ollama",
        "--model-name", "qwen3.6:latest",
        "--ollama-host", "localhost",
        "--ollama-port", "11434",
        "--log-dir", "./logs",
        "--output-dir", "./analysis"
      ]
    }
  ]
}
